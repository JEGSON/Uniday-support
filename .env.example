# Copy to .env and replace the placeholder with the application user's password.
MONGODB_URI=mongodb://unidays_app:REPLACE_WITH_APP_PASSWORD@127.0.0.1:27017/?authSource=admin
MONGODB_AUTH_DB=auth_db
MONGODB_AUDIT_DB=audit_db
REGISTRY_URI=mongodb://registry_app:REPLACE_WITH_REGISTRY_PASSWORD@127.0.0.1:27017/?authSource=registry_db
# Use a separate local importer with find, insert and createIndex on the registry only.
REGISTRY_SEED_URI=mongodb://registry_importer:REPLACE_WITH_IMPORTER_PASSWORD@127.0.0.1:27017/?authSource=registry_db
CASES_URI=mongodb://cases_app:REPLACE_WITH_CASES_PASSWORD@127.0.0.1:27017/?authSource=cases_db
CASES_DB=cases_db
STATS_URI=mongodb://stats_reader:REPLACE_WITH_STATS_PASSWORD@127.0.0.1:27017/?authSource=cases_db
MONGO_AUDIT_WRITE_URI=mongodb://audit_app:REPLACE_WITH_AUDIT_PASSWORD@127.0.0.1:27017/?authSource=audit_db
MONGO_AUDIT_READ_URI=mongodb://audit_reader:REPLACE_WITH_AUDIT_READER_PASSWORD@127.0.0.1:27017/?authSource=audit_db
BASE_URL=http://127.0.0.1:5000
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
