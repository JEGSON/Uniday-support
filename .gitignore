# Keep credentials, encryption keys and local certificates out of Git.
.env
.env.*
!.env.example
secrets/
deploy/certs/
*.key
*.pem

# Exclude local environments and generated artifacts.
.venv/
.venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
test-results/
playwright-report/

# Raw downloads and generated data need explicit review before inclusion.
data/raw/
data/processed/
# Ignore other datasets by default; the single tracked CSV is fictional example data.
data/**/*.csv
!data/examples/student_registry.example.csv
# Local database files must not become repository artifacts.
*.sqlite
*.sqlite3
*.db
